rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /gameStatuses/{gameId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status in ['pendente', 'registrado', 'apostado']
          && request.resource.data.wallet == 'C2';
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /contests/{contestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.wallet == 'C2'
          && request.resource.data.number is int
          && request.resource.data.numbers is list
          && request.resource.data.numbers.size() == 6;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
